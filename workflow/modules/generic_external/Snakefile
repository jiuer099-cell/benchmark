"""Reusable Snakemake module for one generic external-tool invocation.

The importing workflow supplies a ``generic_external`` config mapping. The
benchmark-owned rule wrapper records the execution manifest; user code itself
is launched only by ``pgbench_exec.py``.
"""

from pathlib import Path
import os
import sys

import yaml


SETTINGS = config["generic_external"]
ASSETS = dict(SETTINGS["inputs"])
OUTPUT_DIR = Path(SETTINGS["output_dir"])
OUTPUT_VCF = str(OUTPUT_DIR / SETTINGS["output_vcf_relative"])
EXECUTOR = SETTINGS["executor"]
SCHEMA = SETTINGS["schema"]
RULE_EXECUTOR = SETTINGS["rule_executor"]
RULE_SOURCE = "workflow/modules/generic_external/Snakefile"
CORE_ENVIRONMENT = "workflow/envs/core.yaml"
PROVENANCE_LIBRARY = "workflow/scripts/pgbench_provenance.py"
# Resolve Python after Snakemake activates the plugin's declared environment.
# The generic executor performs schema/provenance validation before it enters
# a plugin sandbox.  Use the workflow interpreter explicitly: a bare
# ``python`` can resolve to a caller's pre-existing environment after Conda
# activation on shared Linux hosts.
PYTHON_EXECUTABLE = sys.executable
GRAPH_ASSET_MANIFEST = SETTINGS.get("graph_asset_manifest")
GRAPH_ASSET_LOCK = SETTINGS.get("graph_asset_lock")
FROZEN_NATIVE_OUTPUT = SETTINGS.get("frozen_native_output")
REPLAY_MODE = FROZEN_NATIVE_OUTPUT is not None
IMPORT_SCRIPT = "workflow/scripts/import_frozen_native_output.py"
REPLAY_SOURCES = (
    [
        FROZEN_NATIVE_OUTPUT["source_vcf"],
        FROZEN_NATIVE_OUTPUT["source_resolved_inputs"],
        FROZEN_NATIVE_OUTPUT["source_attempt_record"],
        FROZEN_NATIVE_OUTPUT["source_tool_manifest"],
    ]
    if REPLAY_MODE
    else []
)
IMPORT_AUDIT = str(OUTPUT_DIR / "meta" / "frozen-native-import.json")


def resolve_plugin_execution_path(value):
    """Resolve one manifest-relative plugin code path for DAG tracking."""

    if value is None:
        return None
    candidate = Path(value)
    if not candidate.is_absolute():
        candidate = Path(SETTINGS["tool_manifest"]).parent / candidate
    return str(candidate.resolve())


with open(SETTINGS["tool_manifest"], encoding="utf-8") as handle:
    TOOL_MANIFEST = yaml.safe_load(handle)
if not isinstance(TOOL_MANIFEST, dict):
    raise ValueError("generic external tool manifest must be a YAML mapping")
PLUGIN_EXECUTION = TOOL_MANIFEST.get("execution")
if not isinstance(PLUGIN_EXECUTION, dict):
    raise ValueError("generic external tool manifest must declare execution")
PLUGIN_RUNNER = resolve_plugin_execution_path(PLUGIN_EXECUTION.get("runner"))
if PLUGIN_RUNNER is None:
    raise ValueError("generic external tool manifest must declare a runner")
PLUGIN_ENVIRONMENT = resolve_plugin_execution_path(
    PLUGIN_EXECUTION.get("environment")
)
PLUGIN_ENVIRONMENT_LOCK_CANDIDATE = (
    Path(PLUGIN_ENVIRONMENT).with_name("environment.linux-64.explicit.txt")
    if PLUGIN_ENVIRONMENT is not None
    else None
)
PLUGIN_ENVIRONMENT_LOCK = (
    str(PLUGIN_ENVIRONMENT_LOCK_CANDIDATE)
    if PLUGIN_ENVIRONMENT_LOCK_CANDIDATE is not None
    and PLUGIN_ENVIRONMENT_LOCK_CANDIDATE.is_file()
    else None
)
PLUGIN_RULE_REGISTRY = resolve_plugin_execution_path(
    PLUGIN_EXECUTION.get("rule_registry")
)
PLUGIN_EXPLICIT_INPUTS = [
    path
    for path in (PLUGIN_RUNNER, PLUGIN_ENVIRONMENT, PLUGIN_RULE_REGISTRY)
    if path is not None
]
PLUGIN_ROOT = Path(SETTINGS["tool_manifest"]).parent
PLUGIN_PACKAGE_INPUTS = sorted(
    str(path)
    for path in PLUGIN_ROOT.rglob("*")
    if (path.is_file() or path.is_symlink())
    and "__pycache__" not in path.parts
    and path.suffix.casefold() not in {".pyc", ".pyo"}
)


def unique_paths(paths):
    """Return deterministic first-occurrence path de-duplication."""

    seen = set()
    result = []
    for path in paths:
        normalized = str(path)
        if normalized in seen:
            continue
        seen.add(normalized)
        result.append(normalized)
    return result


PLUGIN_CODE_INPUTS = unique_paths(
    [*PLUGIN_EXPLICIT_INPUTS, *PLUGIN_PACKAGE_INPUTS]
)
PLUGIN_PACKAGE_EXTRA_INPUTS = [
    path
    for path in PLUGIN_PACKAGE_INPUTS
    if path
    not in {
        SETTINGS["tool_manifest"],
        *PLUGIN_EXPLICIT_INPUTS,
    }
]
INPUT_ARGUMENTS = [
    item
    for name, path in sorted(ASSETS.items())
    for item in ("--input", f"{name}={path}")
]
ALIGNMENT_ARGUMENTS = (
    ["--alignment-kind", SETTINGS["alignment_kind"]]
    if SETTINGS.get("alignment_kind")
    else []
)
PROVENANCE_INPUTS = [
    SETTINGS["tool_manifest"],
    SCHEMA,
    RULE_SOURCE,
    RULE_EXECUTOR,
    EXECUTOR,
    CORE_ENVIRONMENT,
    PROVENANCE_LIBRARY,
    *PLUGIN_CODE_INPUTS,
    SETTINGS["config_snapshot"],
    SETTINGS["score_profile"],
    SETTINGS["run_context"],
    *([GRAPH_ASSET_MANIFEST] if GRAPH_ASSET_MANIFEST is not None else []),
    *([GRAPH_ASSET_LOCK] if GRAPH_ASSET_LOCK is not None else []),
    *ASSETS.values(),
    *([PLUGIN_ENVIRONMENT_LOCK] if PLUGIN_ENVIRONMENT_LOCK is not None else []),
    *([IMPORT_SCRIPT] if REPLAY_MODE else []),
    *REPLAY_SOURCES,
]
PROVENANCE_INPUT_ARGUMENTS = [
    item
    for path in PROVENANCE_INPUTS
    for item in ("--input", str(path))
]
UPSTREAM_ARGUMENTS = [
    item
    for path in SETTINGS["upstream_manifests"]
    for item in ("--upstream-manifest", str(path))
]


rule generic_external_tool:
    input:
        tool_manifest=SETTINGS["tool_manifest"],
        schema=SCHEMA,
        config_snapshot=SETTINGS["config_snapshot"],
        score_profile=SETTINGS["score_profile"],
        run_context=SETTINGS["run_context"],
        graph_asset_manifest=(
            [GRAPH_ASSET_MANIFEST]
            if GRAPH_ASSET_MANIFEST is not None
            else []
        ),
        graph_asset_lock=(
            [GRAPH_ASSET_LOCK]
            if GRAPH_ASSET_LOCK is not None
            else []
        ),
        assets=list(ASSETS.values()),
        upstream_manifests=SETTINGS["upstream_manifests"],
        rule_source=RULE_SOURCE,
        rule_executor=RULE_EXECUTOR,
        executor=EXECUTOR,
        environment=CORE_ENVIRONMENT,
        provenance_library=PROVENANCE_LIBRARY,
        plugin_runner=PLUGIN_RUNNER,
        plugin_environment=(
            [PLUGIN_ENVIRONMENT] if PLUGIN_ENVIRONMENT is not None else []
        ),
        plugin_environment_lock=(
            [PLUGIN_ENVIRONMENT_LOCK] if PLUGIN_ENVIRONMENT_LOCK is not None else []
        ),
        plugin_rule_registry=(
            [PLUGIN_RULE_REGISTRY]
            if PLUGIN_RULE_REGISTRY is not None
            else []
        ),
        plugin_package=PLUGIN_PACKAGE_EXTRA_INPUTS,
        replay_sources=REPLAY_SOURCES,
    output:
        vcf=update(OUTPUT_VCF),
        resolved_inputs=update(SETTINGS["resolved_inputs"]),
        attempt_record=update(SETTINGS["attempt_record"]),
        import_audit=(update(IMPORT_AUDIT) if REPLAY_MODE else []),
        rule_manifest=update(SETTINGS["rule_manifest"]),
    log:
        SETTINGS["log"],
    benchmark:
        repeat(
            SETTINGS["benchmark"],
            SETTINGS.get("benchmark_repeats", 1),
        ),
    threads:
        SETTINGS.get("threads", 1)
    resources:
        mem_mb=SETTINGS.get("memory_mb", 1024)
    params:
        mode=SETTINGS["mode"],
        run_id=SETTINGS["run_id"],
        sample_id=SETTINGS["sample_id"],
        output_dir=str(OUTPUT_DIR),
        input_arguments=INPUT_ARGUMENTS,
        alignment_arguments=ALIGNMENT_ARGUMENTS,
        conda_lock_arguments=(
            ["--conda-lock", PLUGIN_ENVIRONMENT_LOCK]
            if PLUGIN_ENVIRONMENT_LOCK is not None
            else []
        ),
        provenance_input_arguments=PROVENANCE_INPUT_ARGUMENTS,
        upstream_arguments=UPSTREAM_ARGUMENTS,
        execution_purpose=SETTINGS.get("execution_purpose", "development_only"),
        timeout_seconds=SETTINGS.get("timeout_seconds", 3600),
        cache_policy=SETTINGS.get(
            "cache_policy", "isolated_empty_tool_cache"
        ),
        semantic_rule_name=SETTINGS["semantic_rule_name"],
        job_key=SETTINGS["job_key"],
        tool_id=SETTINGS["tool_id"],
        tool_log=SETTINGS["tool_log"],
        pangenome_manifest=SETTINGS["pangenome_manifest"],
        reference=SETTINGS["reference"],
        truth_profile=SETTINGS["truth_profile"],
        snakemake_version=SETTINGS["snakemake_version"],
        execution_profile=SETTINGS["execution_profile"],
        random_seed=SETTINGS["random_seed"],
        replay_mode=("true" if REPLAY_MODE else "false"),
        execution_script=(IMPORT_SCRIPT if REPLAY_MODE else EXECUTOR),
        source_vcf=(FROZEN_NATIVE_OUTPUT["source_vcf"] if REPLAY_MODE else ""),
        source_resolved_inputs=(FROZEN_NATIVE_OUTPUT["source_resolved_inputs"] if REPLAY_MODE else ""),
        source_attempt_record=(FROZEN_NATIVE_OUTPUT["source_attempt_record"] if REPLAY_MODE else ""),
        source_tool_manifest=(FROZEN_NATIVE_OUTPUT["source_tool_manifest"] if REPLAY_MODE else ""),
        execution_arguments=(
            [
                "--tool-id", SETTINGS["tool_id"],
                "--source-vcf", FROZEN_NATIVE_OUTPUT["source_vcf"],
                "--source-resolved-inputs", FROZEN_NATIVE_OUTPUT["source_resolved_inputs"],
                "--source-attempt-record", FROZEN_NATIVE_OUTPUT["source_attempt_record"],
                "--source-tool-manifest", FROZEN_NATIVE_OUTPUT["source_tool_manifest"],
                "--output-vcf", OUTPUT_VCF,
                "--output-resolved-inputs", SETTINGS["resolved_inputs"],
                "--output-attempt-record", SETTINGS["attempt_record"],
                "--import-audit", IMPORT_AUDIT,
            ]
            if REPLAY_MODE
            else [
                "--tool-manifest", SETTINGS["tool_manifest"],
                "--schema", SCHEMA,
                "--mode", SETTINGS["mode"],
                "--run-id", SETTINGS["run_id"],
                "--sample-id", SETTINGS["sample_id"],
                "--output-dir", str(OUTPUT_DIR),
                "--resolved-inputs", SETTINGS["resolved_inputs"],
                "--attempt-record", SETTINGS["attempt_record"],
                "--log", SETTINGS["tool_log"],
                "--threads", str(SETTINGS.get("threads", 1)),
                "--memory-mb", str(SETTINGS.get("memory_mb", 1024)),
                "--cache-policy", SETTINGS.get("cache_policy", "isolated_empty_tool_cache"),
                "--execution-purpose", SETTINGS.get("execution_purpose", "development_only"),
                "--timeout-seconds", str(SETTINGS.get("timeout_seconds", 3600)),
                "--random-seed", str(SETTINGS["random_seed"]),
                *INPUT_ARGUMENTS,
                *ALIGNMENT_ARGUMENTS,
            ]
        ),
        import_output_arguments=(
            ["--output", IMPORT_AUDIT] if REPLAY_MODE else []
        ),
    # A frozen-native scoring replay executes only Core's authenticated copy
    # transport.  It must not solve or activate the caller's environment:
    # that adapter is deliberately not invoked during replay.
    conda:
        ("../../envs/core.yaml" if REPLAY_MODE else (PLUGIN_ENVIRONMENT or "../../envs/core.yaml"))
    shell:
        """
        {PYTHON_EXECUTABLE:q} {input.rule_executor:q} \
          --rule-name {params.semantic_rule_name:q} \
          --job-key {params.job_key:q} \
          --run-id {params.run_id:q} \
          --module-or-tool-id {params.tool_id:q} \
          --snakefile-path {input.rule_source:q} \
          --rule-source-path {input.rule_source:q} \
          --script-or-wrapper-path {params.execution_script:q} \
          --config-snapshot {input.config_snapshot:q} \
          --score-profile {input.score_profile:q} \
          {params.conda_lock_arguments:q} \
          --run-context {input.run_context:q} \
          --pangenome-manifest {params.pangenome_manifest:q} \
          --reference {params.reference:q} \
          --truth-profile {params.truth_profile:q} \
          --snakemake-version {params.snakemake_version:q} \
          --execution-profile {params.execution_profile:q} \
          --random-seed {params.random_seed} \
          --threads {threads} \
          --resource mem_mb={resources.mem_mb} \
          --param mode={params.mode:q} \
          --param execution_purpose={params.execution_purpose:q} \
          {params.provenance_input_arguments:q} \
          --output {output.vcf:q} \
          --output {output.resolved_inputs:q} \
          --output {output.attempt_record:q} \
          {params.import_output_arguments:q} \
          {params.upstream_arguments:q} \
          --manifest-output {output.rule_manifest:q} \
          -- \
          {PYTHON_EXECUTABLE:q} {params.execution_script:q} \
            {params.execution_arguments:q} \
          > {log:q} 2>&1
        """
